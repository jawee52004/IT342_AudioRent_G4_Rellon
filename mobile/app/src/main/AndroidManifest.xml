<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioRent"
        tools:targetApi="31">
        
        <activity
            android:name="edu.rellon.audiorent.features.packages.PackageListActivity"
            android:exported="false" />

        <activity
            android:name="edu.rellon.audiorent.features.rental.ProviderEarningsActivity"
            android:exported="false" />
            
        <activity
            android:name="edu.rellon.audiorent.features.rental.RentalHistoryActivity"
            android:exported="false" />

        <activity
            android:name="edu.rellon.audiorent.features.packages.PackageDetailActivity"
            android:exported="false" />
            
        <activity
            android:name="edu.rellon.audiorent.features.packages.AddPackageActivity"
            android:exported="false" />

        <activity
            android:name="edu.rellon.audiorent.features.auth.AdminDashboardActivity"
            android:exported="false" />
            
        <activity
            android:name="edu.rellon.audiorent.features.packages.ProviderPackagesActivity"
            android:exported="false" />
            
        <activity
            android:name="edu.rellon.audiorent.features.auth.MainActivity"
            android:exported="false" />
        
        <activity
            android:name="edu.rellon.audiorent.features.auth.RegisterActivity"
            android:exported="false" />
            
        <activity
            android:name="edu.rellon.audiorent.features.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
    </application>

</manifest>